# Copy this file to .env and fill in your values.
# .env is git-ignored and will never be committed.

# ── Azure Content Understanding ──────────────────────────────────────────────
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://<your-account>.cognitiveservices.azure.com/

# ── Azure Translator ─────────────────────────────────────────────────────────
AZURE_TRANSLATOR_KEY=<your-translator-key>
AZURE_TRANSLATOR_REGION=<your-region>
# e.g. eastus

# ── Azure Speech ─────────────────────────────────────────────────────────────
AZURE_SPEECH_KEY=<your-speech-key>
AZURE_SPEECH_REGION=<your-speech-region>
# e.g. eastus

# ── Azure Vision ─────────────────────────────────────────────────────────────
AZURE_VISION_ENDPOINT=https://<your-account>.cognitiveservices.azure.com/
AZURE_VISION_KEY=<your-vision-key>

# ── Azure Language ───────────────────────────────────────────────────────────
AZURE_LANGUAGE_ENDPOINT=https://<your-account>.cognitiveservices.azure.com/
AZURE_LANGUAGE_KEY=<your-language-key>
