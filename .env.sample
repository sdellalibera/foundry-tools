# Copy this file to .env and fill in your values.
# .env is git-ignored and will never be committed.

# ── Microsoft Foundry (shared across all services) ───────────────────────────
AZURE_AI_ENDPOINT=https://<your-account>.services.ai.azure.com/
AZURE_AI_KEY=<your-api-key>
AZURE_AI_REGION=<your-region>
