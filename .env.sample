# Copy this file to .env and fill in your values.
# .env is git-ignored and will never be committed.

# ── Microsoft Foundry (shared across all services) ───────────────────────────
FOUNDRY_AI_SERVICES_ENDPOINT=https://<your-account>.services.ai.azure.com/
FOUNDRY_AI_SERVICES_KEY=<your-api-key>
FOUNDRY_AI_SERVICES_REGION=<your-region>
